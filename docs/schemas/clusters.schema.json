{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "protein",
              "rna"
            ],
            "description": "rna: the cluster has no amino-acid alignment"
          },
          "strains": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of strains that have the gene"
          },
          "length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Mean gene length in nucleotides"
          },
          "annotation": {
            "type": [
              "string",
              "null"
            ]
          },
          "gene": {
            "type": [
              "string",
              "null"
            ]
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "genes": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "duplications": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "description": "[accession, copies] for each strain with more than one copy"
          },
          "events": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Number of gain and loss events"
          },
          "diversity": {
            "type": [
              "number",
              "null"
            ]
          },
          "range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2,
            "description": "Inclusive byte range [first, last] of the cluster's member in gene_clusters.tar.gz"
          },
          "extra": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "null"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "strains",
          "length",
          "annotation",
          "gene",
          "annotations",
          "genes",
          "duplications",
          "events",
          "diversity",
          "range",
          "extra"
        ],
        "additionalProperties": {}
      },
      "description": "Clusters in descending strain count"
    }
  },
  "required": [
    "clusters"
  ],
  "additionalProperties": {},
  "title": "clusters.json",
  "description": "The cluster table of a dataset"
}
