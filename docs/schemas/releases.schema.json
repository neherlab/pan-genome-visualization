{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1,
      "description": "Format of the data files"
    },
    "default": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z$",
      "description": "The release that the app shows without ?release=; a listed release"
    },
    "releases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{8}T\\d{6}Z$",
            "description": "UTC creation time, ISO 8601 basic format"
          },
          "format": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Format of every file of the release"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "format",
          "title"
        ],
        "additionalProperties": {}
      },
      "description": "Every live release, newest first"
    }
  },
  "required": [
    "format",
    "default",
    "releases"
  ],
  "additionalProperties": {},
  "title": "releases.json",
  "description": "The live releases of a data root"
}
